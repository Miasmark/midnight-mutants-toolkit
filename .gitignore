# Cartridge images. This repository is deliberately ROM-free: the tools work on
# a copy you already own, and keeping that true is what makes it safe to share.
# These patterns are the safety net, so a stray dump in the working directory
# can never be committed by accident.
*.a78
*.bin
*.rom
*.zip

# Generated by the tools rather than written by hand.
src/
src-pal/
build/*
!build/_spritenames.py
!build/regions.json
*.wav
*.log

# Test builds and patched images.
testbuilds/
*.bak

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and the usual desktop litter
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
